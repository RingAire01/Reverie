// Reverie / Windows backend - WebView2 host bindings.
//
// These call the C shim in shim/reverie_webview2.c, which owns the WebView2 COM
// details. Link the runtime with:
//
//   rev build src/main.reo \
//     --lib-dir shim --link reverie_webview2 --link ole32 -o app.exe
//
// and ship WebView2Loader.dll next to the executable.

extern {
    fn reverie_win_init();
    fn reverie_webview_start(hwnd: u64, url: str) -> i32;
    fn reverie_webview_state() -> i32;
    fn reverie_webview_stop();
    fn reverie_webview_error() -> str;
    fn reverie_webview_set_folder(host: str, dir: str) -> i32;
    fn reverie_webview_send(message: str) -> i32;
    fn reverie_webview_poll() -> str;
    fn reverie_webview_on_message(handler: fn(str));
    fn reverie_webview_allow_host(host: str);
    fn reverie_webview_navigate(url: str) -> i32;
    fn reverie_webview_last_blocked() -> str;
    fn reverie_webview_register_command(name: str, handler: fn(str));
}

// Process-wide init (DPI awareness). Call before creating windows.
fn reverie_init() {
    reverie_win_init();
}

// Host `url` inside `hwnd`. Returns 0 once the request is dispatched; the
// WebView2 is created asynchronously while the message loop runs.
fn reverie_webview_open(hwnd: u64, url: str) -> i32 {
    return reverie_webview_start(hwnd, url);
}

// 0 idle, 1 environment ready, 2 controller ready, 3 navigated, <0 failed.
fn reverie_webview_status() -> i32 {
    return reverie_webview_state();
}

fn reverie_webview_last_error() -> str {
    return reverie_webview_error();
}

fn reverie_webview_close() {
    reverie_webview_stop();
}

// Serve a local folder over https at `host` (for example "reverie.local"),
// so the bundled frontend loads without a dev server.
fn reverie_asset_folder(host: str, dir: str) -> i32 {
    return reverie_webview_set_folder(host, dir);
}

// Send a UTF-8 message to the page.
fn reverie_send(message: str) -> i32 {
    return reverie_webview_send(message);
}

// Next message the page posted, or "" when none.
fn reverie_poll() -> str {
    return reverie_webview_poll();
}

// Push: register a handler called for each message the page posts.
fn reverie_on_message(handler: fn(str)) {
    reverie_webview_on_message(handler);
}

// Allow an additional host to be loaded (reverie.local and localhost are
// always allowed; other hosts are blocked by default).
fn reverie_allow_host(host: str) {
    reverie_webview_allow_host(host);
}

// Navigate to url, subject to the host policy.
fn reverie_navigate(url: str) -> i32 {
    return reverie_webview_navigate(url);
}

// URI of the most recent blocked navigation, or "".
fn reverie_last_blocked() -> str {
    return reverie_webview_last_blocked();
}

// Register a command. The page sends "name" or "name:arg"; only registered
// names are routed (the registry is the allowlist).
fn reverie_register_command(name: str, handler: fn(str)) {
    reverie_webview_register_command(name, handler);
}
