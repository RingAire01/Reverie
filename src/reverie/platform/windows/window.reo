@cfg(windows)
module reverie_windows_window {
// Reverie / Windows backend - window lifecycle.

// WS_OVERLAPPEDWINDOW = 0x00CF0000, WS_POPUP = 0x80000000, WS_EX_TOPMOST = 8,
// WS_EX_LAYERED = 0x00080000, SW_HIDE = 0, SW_SHOW = 5, SW_MAXIMIZE = 3,
// SW_MINIMIZE = 6, SW_RESTORE = 9, LWA_ALPHA = 2.
fn reverie_ws_overlappedwindow() -> u32 { return 13565952; }
fn reverie_ws_ex_layered() -> u32 { return 524288; }
fn reverie_sw_show() -> i32 { return 5; }
fn reverie_sw_hide() -> i32 { return 0; }
fn reverie_sw_maximize() -> i32 { return 3; }
fn reverie_sw_minimize() -> i32 { return 6; }
fn reverie_sw_restore() -> i32 { return 9; }

// HWND_TOPMOST / HWND_NOTOPMOST are (HWND)-1 / (HWND)-2.
fn reverie_hwnd_topmost() -> u64 { return (0 - 1) as u64; }
fn reverie_hwnd_notopmost() -> u64 { return (0 - 2) as u64; }

// The shim owns DWM backdrop/icon/theme calls and persisted window geometry;
// minimum size is enforced through WM_GETMINMAXINFO. Zero means "no constraint".
extern {
    fn reverie_window_set_limits(hwnd: u64, min_width: i32, min_height: i32,
                                 max_width: i32, max_height: i32) -> i32;
    fn reverie_window_set_icon(hwnd: u64, path: str) -> i32;
    fn reverie_window_set_backdrop(hwnd: u64, kind: i32) -> i32;
    fn reverie_window_set_theme(hwnd: u64, mode: i32) -> i32;
    fn reverie_state_restore(hwnd: u64) -> i32;
    fn reverie_state_save(hwnd: u64);
}

// Window style/ex-style derived from configuration. Fullscreen and borderless
// use WS_POPUP; non-resizable clears WS_THICKFRAME and WS_MAXIMIZEBOX.
fn reverie_window_style() -> u32 {
    if reverie_cfg_fullscreen() != 0 {
        return 2147483648;
    }
    if reverie_cfg_decorations() == 0 {
        return 2147483648;
    }
    let style: u32 = reverie_ws_overlappedwindow();
    if reverie_cfg_resizable() == 0 {
        // Clear WS_THICKFRAME (0x00040000) and WS_MAXIMIZEBOX (0x00010000).
        style = style & ((~ (262144 | 65536)) as u32);
    }
    return style;
}

fn reverie_window_exstyle() -> u32 {
    let ex: u32 = 0;
    if reverie_cfg_always_on_top() != 0 {
        ex = ex | 8;
    }
    // WS_EX_LAYERED must be present before SetLayeredWindowAttributes works.
    if reverie_cfg_opacity() < 255 {
        ex = ex | reverie_ws_ex_layered();
    }
    return ex;
}

fn reverie_window_show_cmd() -> i32 {
    if reverie_cfg_fullscreen() != 0 {
        return 3;
    }
    return reverie_sw_show();
}

// Default window procedure: quits on WM_DESTROY, closes on WM_CLOSE, and quits
// when the demo timer fires. Apps may pass their own procedure instead.
fn reverie_default_proc(hwnd: u64, msg: u32, wparam: u64, lparam: u64) -> u64 {
    if msg == reverie_wm_destroy() {
        if reverie_cfg_remember() != 0 {
            reverie_state_save(hwnd);
        }
        PostQuitMessage(0);
        return 0;
    }
    if msg == reverie_wm_close() {
        DestroyWindow(hwnd);
        return 0;
    }
    if msg == reverie_wm_timer() {
        KillTimer(hwnd, 1);
        DestroyWindow(hwnd);
        return 0;
    }
    return DefWindowProcA(hwnd, msg, wparam, lparam);
}

fn reverie_register_class(class_name: str, proc: fn(u64, u32, u64, u64) -> u64) -> u16 {
    let wc = WndClassA {
        style: 0,
        wndproc: proc,
        cls_extra: 0,
        wnd_extra: 0,
        instance: GetModuleHandleA(0),
        icon: 0,
        cursor: 0,
        background: 0,
        menu_name: "",
        class_name: class_name,
    };
    return RegisterClassA(&wc);
}

// Registers the class and creates, shows, and updates the window.
fn reverie_create_window(class_name: str, title: str, width: i32, height: i32,
                         proc: fn(u64, u32, u64, u64) -> u64) -> u64 {
    reverie_register_class(class_name, proc);
    let x: i32 = reverie_cfg_x();
    let y: i32 = reverie_cfg_y();
    if x < 0 || y < 0 {
        if reverie_cfg_center() != 0 {
            x = (GetSystemMetrics(0) - width) / 2;
            y = (GetSystemMetrics(1) - height) / 2;
        } else {
            x = 120;
            y = 120;
        }
    }
    let hwnd: u64 = CreateWindowExA(reverie_window_exstyle(), class_name, title,
        reverie_window_style(), x, y, width, height, 0, 0, GetModuleHandleA(0), 0);
    ShowWindow(hwnd, reverie_window_show_cmd());
    UpdateWindow(hwnd);
    return hwnd;
}

// Posts WM_TIMER once after `ms`, which the default procedure turns into an exit.
fn reverie_quit_after(hwnd: u64, ms: u32) {
    SetTimer(hwnd, 1, ms, 0);
}

// ---- runtime window control ----

fn reverie_window_set_title(hwnd: u64, title: str) -> i32 {
    return SetWindowTextA(hwnd, title);
}

// Move without resizing: SWP_NOSIZE|SWP_NOZORDER|SWP_NOACTIVATE = 21.
fn reverie_window_set_position(hwnd: u64, x: i32, y: i32) -> i32 {
    return SetWindowPos(hwnd, 0, x, y, 0, 0, 21);
}

// Resize without moving: SWP_NOMOVE|SWP_NOZORDER|SWP_NOACTIVATE = 22.
fn reverie_window_set_size(hwnd: u64, width: i32, height: i32) -> i32 {
    return SetWindowPos(hwnd, 0, 0, 0, width, height, 22);
}

fn reverie_window_center(hwnd: u64, width: i32, height: i32) -> i32 {
    let x: i32 = (GetSystemMetrics(0) - width) / 2;
    let y: i32 = (GetSystemMetrics(1) - height) / 2;
    return reverie_window_set_position(hwnd, x, y);
}

fn reverie_window_set_opacity(hwnd: u64, alpha: i32) -> i32 {
    let a: i32 = alpha;
    if a < 0 { a = 0; }
    if a > 255 { a = 255; }
    return SetLayeredWindowAttributes(hwnd, 0, a as u32, 2);
}

// SWP_NOMOVE|SWP_NOSIZE|SWP_NOACTIVATE = 19.
fn reverie_window_set_always_on_top(hwnd: u64, on: i32) -> i32 {
    let target: u64 = reverie_hwnd_notopmost();
    if on != 0 { target = reverie_hwnd_topmost(); }
    return SetWindowPos(hwnd, target, 0, 0, 0, 0, 19);
}

fn reverie_window_minimize(hwnd: u64) -> i32 { return ShowWindow(hwnd, reverie_sw_minimize()); }
fn reverie_window_maximize(hwnd: u64) -> i32 { return ShowWindow(hwnd, reverie_sw_maximize()); }
fn reverie_window_restore(hwnd: u64) -> i32 { return ShowWindow(hwnd, reverie_sw_restore()); }
fn reverie_window_show(hwnd: u64) -> i32 { return ShowWindow(hwnd, reverie_sw_show()); }
fn reverie_window_hide(hwnd: u64) -> i32 { return ShowWindow(hwnd, reverie_sw_hide()); }
fn reverie_window_close(hwnd: u64) -> i32 { return PostMessageA(hwnd, reverie_wm_close(), 0, 0); }

// Minimum content size, enforced by the shim through WM_GETMINMAXINFO.
fn reverie_window_set_min_size(hwnd: u64, width: i32, height: i32) -> i32 {
    return reverie_window_set_limits(hwnd, width, height, 0, 0);
}

// Menu bar. Build popups with reverie_menu_popup, add items with
// reverie_menu_item, then attach to the window with reverie_menu_attach.
// Selecting an item delivers WM_COMMAND (reverie_wm_command) with the id in the
// low word of wparam.
fn reverie_menu_bar() -> u64 {
    return CreateMenu();
}

fn reverie_menu_popup() -> u64 {
    return CreatePopupMenu();
}

// MF_STRING = 0: a normal item.
fn reverie_menu_item(menu: u64, id: u32, label: str) -> i32 {
    return AppendMenuA(menu, 0, id as u64, label);
}

// MF_POPUP = 0x10: a submenu.
fn reverie_menu_submenu(bar: u64, popup: u64, label: str) -> i32 {
    return AppendMenuA(bar, 16, popup, label);
}

fn reverie_menu_attach(hwnd: u64, menu: u64) -> i32 {
    let result: i32 = SetMenu(hwnd, menu);
    DrawMenuBar(hwnd);
    return result;
}

// Menu id from a WM_COMMAND wparam (low word).
fn reverie_menu_id(wparam: u64) -> u32 {
    return (wparam & 65535) as u32;
}

}
