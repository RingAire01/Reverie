// Reverie / Linux backend skeleton (GTK + WebKitGTK).
//
// Not yet implemented. The shape mirrors the Windows backend and delegates all
// OS work to a C shim (the GTK/WebKitGTK equivalent of
// shim/reverie_webview2.c). The whole module is guarded by @cfg(linux), so it
// is dropped when compiling for another host.

@cfg(linux)
module reverie_linux {
    extern {
        fn reverie_linux_init();
        fn reverie_linux_log(message: str);
        fn reverie_linux_create_window(class_name: str, title: str, width: i32, height: i32) -> u64;
        fn reverie_linux_run_loop() -> i32;
        fn reverie_linux_quit_after(hwnd: u64, ms: u32);
        fn reverie_linux_allow_host(host: str);
        fn reverie_linux_webview_open(hwnd: u64, url: str) -> i32;
        fn reverie_linux_webview_state(hwnd: u64) -> i32;
        fn reverie_linux_webview_send(hwnd: u64, message: str) -> i32;
        fn reverie_linux_webview_poll(hwnd: u64) -> str;
        fn reverie_linux_webview_set_folder(hwnd: u64, host: str, dir: str) -> i32;
        fn reverie_linux_webview_navigate(hwnd: u64, url: str) -> i32;
        fn reverie_linux_webview_on_message(handler: fn(str));
        fn reverie_linux_webview_message_window() -> u64;
        fn reverie_linux_webview_register_command(name: str, handler: fn(str));
        fn reverie_linux_webview_stop(hwnd: u64);
        fn reverie_linux_webview_error() -> str;
        fn reverie_linux_webview_last_blocked() -> str;
        fn reverie_linux_tray_add(hwnd: u64, tooltip: str) -> i32;
        fn reverie_linux_tray_remove();
        fn reverie_linux_dialog_open(pattern: str) -> str;
        fn reverie_linux_dialog_save(pattern: str) -> str;
        fn reverie_linux_default_proc(hwnd: u64, msg: u32, wparam: u64, lparam: u64) -> u64;
    }

    fn reverie_win_init() { reverie_linux_init(); }
    fn reverie_init() { reverie_linux_init(); }
    fn reverie_log(message: str) { reverie_linux_log(message); }
    fn reverie_allow_host(host: str) { reverie_linux_allow_host(host); }

    fn reverie_create_window(class_name: str, title: str, width: i32, height: i32,
                             proc: fn(u64, u32, u64, u64) -> u64) -> u64 {
        let hwnd: u64 = reverie_linux_create_window(class_name, title, width, height);
        let x: i32 = reverie_cfg_x();
        let y: i32 = reverie_cfg_y();
        if x >= 0 && y >= 0 {
            reverie_linux_window_set_position(hwnd, x, y);
        } else if reverie_cfg_center() != 0 {
            reverie_linux_window_center(hwnd, width, height);
        }
        return hwnd;
    }
    fn reverie_run_loop() -> i32 { return reverie_linux_run_loop(); }
    fn reverie_quit_after(hwnd: u64, ms: u32) { reverie_linux_quit_after(hwnd, ms); }
    fn reverie_default_proc(hwnd: u64, msg: u32, wparam: u64, lparam: u64) -> u64 {
        return reverie_linux_default_proc(hwnd, msg, wparam, lparam);
    }

    extern {
        fn reverie_linux_window_set_title(hwnd: u64, title: str);
        fn reverie_linux_window_set_position(hwnd: u64, x: i32, y: i32);
        fn reverie_linux_window_set_size(hwnd: u64, width: i32, height: i32);
        fn reverie_linux_window_center(hwnd: u64, width: i32, height: i32);
        fn reverie_linux_window_set_opacity(hwnd: u64, alpha: i32);
        fn reverie_linux_window_set_always_on_top(hwnd: u64, on: i32);
        fn reverie_linux_window_minimize(hwnd: u64);
        fn reverie_linux_window_maximize(hwnd: u64);
        fn reverie_linux_window_restore(hwnd: u64);
        fn reverie_linux_window_show(hwnd: u64);
        fn reverie_linux_window_hide(hwnd: u64);
        fn reverie_linux_window_close(hwnd: u64);
        fn reverie_linux_window_set_limits(hwnd: u64, min_width: i32, min_height: i32,
                                           max_width: i32, max_height: i32);
        fn reverie_linux_window_set_icon(hwnd: u64, path: str);
        fn reverie_linux_window_set_backdrop(hwnd: u64, kind: i32);
        fn reverie_linux_window_set_theme(hwnd: u64, mode: i32);
        fn reverie_linux_state_restore(hwnd: u64) -> i32;
        fn reverie_linux_state_save(hwnd: u64);
    }

    fn reverie_window_set_title(hwnd: u64, title: str) -> i32 {
        reverie_linux_window_set_title(hwnd, title); return 0;
    }
    fn reverie_window_set_position(hwnd: u64, x: i32, y: i32) -> i32 {
        reverie_linux_window_set_position(hwnd, x, y); return 0;
    }
    fn reverie_window_set_size(hwnd: u64, width: i32, height: i32) -> i32 {
        reverie_linux_window_set_size(hwnd, width, height); return 0;
    }
    fn reverie_window_center(hwnd: u64, width: i32, height: i32) -> i32 {
        reverie_linux_window_center(hwnd, width, height); return 0;
    }
    fn reverie_window_set_opacity(hwnd: u64, alpha: i32) -> i32 {
        reverie_linux_window_set_opacity(hwnd, alpha); return 0;
    }
    fn reverie_window_set_always_on_top(hwnd: u64, on: i32) -> i32 {
        reverie_linux_window_set_always_on_top(hwnd, on); return 0;
    }
    fn reverie_window_minimize(hwnd: u64) -> i32 { reverie_linux_window_minimize(hwnd); return 0; }
    fn reverie_window_maximize(hwnd: u64) -> i32 { reverie_linux_window_maximize(hwnd); return 0; }
    fn reverie_window_restore(hwnd: u64) -> i32 { reverie_linux_window_restore(hwnd); return 0; }
    fn reverie_window_show(hwnd: u64) -> i32 { reverie_linux_window_show(hwnd); return 0; }
    fn reverie_window_hide(hwnd: u64) -> i32 { reverie_linux_window_hide(hwnd); return 0; }
    fn reverie_window_close(hwnd: u64) -> i32 { reverie_linux_window_close(hwnd); return 0; }
    fn reverie_window_set_min_size(hwnd: u64, width: i32, height: i32) -> i32 {
        reverie_linux_window_set_limits(hwnd, width, height, 0, 0); return 0;
    }
    fn reverie_window_set_icon(hwnd: u64, path: str) -> i32 {
        reverie_linux_window_set_icon(hwnd, path); return 0;
    }
    fn reverie_window_set_backdrop(hwnd: u64, kind: i32) -> i32 {
        reverie_linux_window_set_backdrop(hwnd, kind); return 0;
    }
    fn reverie_window_set_theme(hwnd: u64, mode: i32) -> i32 {
        reverie_linux_window_set_theme(hwnd, mode); return 0;
    }
    fn reverie_state_restore(hwnd: u64) -> i32 { return reverie_linux_state_restore(hwnd); }
    fn reverie_state_save(hwnd: u64) { reverie_linux_state_save(hwnd); }

    fn reverie_webview_open(hwnd: u64, url: str) -> i32 { return reverie_linux_webview_open(hwnd, url); }
    fn reverie_webview_status(hwnd: u64) -> i32 { return reverie_linux_webview_state(hwnd); }
    fn reverie_send(hwnd: u64, message: str) -> i32 { return reverie_linux_webview_send(hwnd, message); }
    fn reverie_poll(hwnd: u64) -> str { return reverie_linux_webview_poll(hwnd); }
    fn reverie_asset_folder(hwnd: u64, host: str, dir: str) -> i32 {
        return reverie_linux_webview_set_folder(hwnd, host, dir);
    }
    fn reverie_navigate(hwnd: u64, url: str) -> i32 { return reverie_linux_webview_navigate(hwnd, url); }
    fn reverie_on_message(handler: fn(str)) { reverie_linux_webview_on_message(handler); }
    fn reverie_message_window() -> u64 { return reverie_linux_webview_message_window(); }
    fn reverie_register_command(name: str, handler: fn(str)) {
        reverie_linux_webview_register_command(name, handler);
    }
    fn reverie_webview_close(hwnd: u64) { reverie_linux_webview_stop(hwnd); }
    fn reverie_webview_last_error() -> str { return reverie_linux_webview_error(); }
    fn reverie_last_blocked() -> str { return reverie_linux_webview_last_blocked(); }

    fn reverie_tray_show(hwnd: u64, tooltip: str) -> i32 { return reverie_linux_tray_add(hwnd, tooltip); }
    fn reverie_tray_hide() { reverie_linux_tray_remove(); }
    fn reverie_open_file(pattern: str) -> str { return reverie_linux_dialog_open(pattern); }
    fn reverie_save_file(pattern: str) -> str { return reverie_linux_dialog_save(pattern); }

    // Menu identifiers are Windows-specific; on Linux provide inert stubs.
    fn reverie_wm_command() -> u32 { return 0; }
    fn reverie_menu_bar() -> u64 { return 0; }
    fn reverie_menu_popup() -> u64 { return 0; }
    fn reverie_menu_item(menu: u64, id: u32, label: str) -> i32 { return 0; }
    fn reverie_menu_submenu(bar: u64, popup: u64, label: str) -> i32 { return 0; }
    fn reverie_menu_attach(hwnd: u64, menu: u64) -> i32 { return 0; }
    fn reverie_menu_id(wparam: u64) -> u32 { return 0; }
}
