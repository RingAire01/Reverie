// Reverie M0 - minimal Win32 C-ABI bindings.
//
// Windows always exposes C ABI: Win32 uses the system calling convention and
// COM uses C-layout vtables. user32 and kernel32 are linked by default by the
// mingw-w64 / LLVM-MinGW runtime, so no extra linker flags are required.
//
// Handles and pointers are modelled as pointer-sized integers, and structs are
// declared in the same field order as their Win32 counterparts. RingEcho emits
// these declarations verbatim, so the C compiler computes the exact layout and
// there is no clash with windows.h.

struct WndClassA {
    style: u32,
    wndproc: fn(u64, u32, u64, u64) -> u64,
    cls_extra: i32,
    wnd_extra: i32,
    instance: u64,
    icon: u64,
    cursor: u64,
    background: u64,
    menu_name: str,
    class_name: str,
}

struct Msg {
    hwnd: u64,
    message: u32,
    wparam: u64,
    lparam: u64,
    time: u32,
    pt_x: i32,
    pt_y: i32,
}

struct Rect {
    left: i32,
    top: i32,
    right: i32,
    bottom: i32,
}

extern {
    fn GetModuleHandleA(name: u64) -> u64;
    fn RegisterClassA(cls: &WndClassA) -> u16;
    fn CreateWindowExA(ex_style: u32, class_name: str, window_name: str, style: u32,
                       x: i32, y: i32, width: i32, height: i32,
                       parent: u64, menu: u64, instance: u64, param: u64) -> u64;
    fn ShowWindow(hwnd: u64, cmd: i32) -> i32;
    fn UpdateWindow(hwnd: u64) -> i32;
    fn DefWindowProcA(hwnd: u64, msg: u32, wparam: u64, lparam: u64) -> u64;
    fn GetMessageA(msg: &Msg, hwnd: u64, min: u32, max: u32) -> i32;
    fn TranslateMessage(msg: &Msg) -> i32;
    fn DispatchMessageA(msg: &Msg) -> u64;
    fn SetTimer(hwnd: u64, id: u64, ms: u32, proc: u64) -> u64;
    fn KillTimer(hwnd: u64, id: u64) -> i32;
    fn DestroyWindow(hwnd: u64) -> i32;
    fn PostQuitMessage(code: i32);
    fn IsWindow(hwnd: u64) -> i32;
    fn GetWindowRect(hwnd: u64, rect: &Rect) -> i32;
}
