// Reverie M1 demo: a Win32 window hosting a WebView2.
//
// Build (from the repo root), with WebView2Loader.dll next to the output:
//
//   rev build src/main.reo \
//     --lib-dir shim --link reverie_webview2 --link ole32 -o app.exe

import "reverie"

fn main() {
    let hwnd: u64 = reverie_create_window("ReverieWindow", "Reverie M1", 900, 600,
        reverie_default_proc);
    println(IsWindow(hwnd));

    let started: i32 = reverie_webview_open(hwnd,
        "data:text/html,<h1 style='font-family:sans-serif'>Reverie M1</h1>");
    println(started);

    reverie_quit_after(hwnd, 4000);
    reverie_run_loop();

    println(reverie_webview_status());
    println(reverie_webview_last_error());
    reverie_webview_close();
    println("Reverie M1 finished");
}
